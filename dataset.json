{
  "allowed_keywords": ["google", "youtube", "amazon"],
  "abnormal_patterns": {
    "special_characters": ["/", "\\", "?", "#", "&", "..", "//", "%", "=", "*", "<", ">", ";", "'", "\""],
    "restricted_keywords": ["admin", "login", "config", "root", "password", "token", "system", "shell", "cmd"]
  },
  "allowed_pattern": "^[a-zA-Z0-9]+$",
  "thresholds": {
    "repeat_suspicious_count": 2
  },
  "rule_notes": [
    "Only exact allowed keywords are considered normal.",
    "Any special-character mismatch becomes abnormal.",
    "Restricted terms always trigger abnormal classification.",
    "Repeated suspicious attempts remain abnormal in session."
  ]
}
